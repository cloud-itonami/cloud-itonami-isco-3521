;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a studio/production-booth robot handles camera
;; framing, audio-level riding and asset ingest during recording sessions
;; (ISCO 3521); editorial work stays human-gated. Its physical work is moving
;; cameras: swinging a camera on an arm to reframe a shot, and wheeling a
;; lighting/equipment cart between studios.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3521"
 :cases
 [{:id :camera-reframe
   :kind :manipulator
   :procedure "camera arm swings the studio camera from a low wide position up to a high close-up position between takes"
   :params {:l1-m 0.60 :l2-m 0.55 :m1-kg 8.0 :m2-kg 6.0
            :from [0.70 0.10] :to [0.30 0.80] :duration-s 3.0 :steps 600}
   :sweep {:param :payload-kg :values [1.5 3.0 5.0 8.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 150.0 :basis "estimate: continuous shoulder torque of a ~10 kg-class collaborative arm"}
   :boundary {:lo 0.5 :hi 60.0}}
  {:id :equipment-cart-light-stand
   :kind :transport
   :procedure "robot wheels a cart carrying a folded light stand and cases between studios and stops at the studio door; the stand height sets the centre of gravity"
   :params {:mass-kg 50.0 :payload-kg 30.0 :distance-m 40.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 1.5 :drive-force-n 150.0 :crr 0.02
            :support-half-length-m 0.25}
   :sweep {:param :cog-height-m :values [0.5 0.7 0.9 1.1 1.4]}
   :quantity :min-tipover-margin
   :limit {:min 0.3 :basis "estimate: keep 30% of the static tip-over moment in reserve for cable ramps and door thresholds"}
   :boundary {:lo 0.2 :hi 2.5}}]}
